<div class="card-body p-3">
  <div class="d-flex flex-start">
    <div>
      <h6 class="fw-bold mb-1"><%= comment.name %> </h6>
      <p class="mb-0">
        <%= comment.body %>
      </p>

      <div class="d-flex mt-3 gap-1">
        <%= link_to "Edit", edit_comment_path(comment), class: "btn btn-sm btn-outline-secondary" %>
        <%= button_to "Delete", comment, :method => :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: 'Are you sure you want to delete comment?' }  %>
      </div>
    </div>
  </div>
</div>

<hr class="my-0" />
