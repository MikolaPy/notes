  <section class="jumbotron text-center mt-5">
    <div class="container">
      <h1 class="jumbotron-heading">Notes list</h1>
      <p class="lead text-muted">Something short and leading about the collection below—its contents, the creator, etc. Make it short and sweet, but not too short so folks don't simply skip over it entirely.</p>
      <p>
        <%= link_to "New note", new_note_path, class: "btn btn-primary my-2" %>
      </p>
    </div>
  </section>

  <div id="notes" class="album py-5 bg-light">
    <div class="container">
      <div class="row">
        <% @notes.each do |note| %>
          <%= render note %>
        <% end %>
      </div>
    </div>
  </div>
