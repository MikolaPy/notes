  <section class="jumbotron text-center mt-5">
    <div class="container">
      <h1 class="jumbotron-heading my-5">Notes list</h1>

      <%= form_with scope: :query, url: notes_path, method: :get,  data: { controller: 'auto-submit',  "turbo-action": "advance", "turbo-frame": "notes" } do |form| %>
        <div class="form-group">
          <%= form.search_field :search, value: params.dig(:query, :search), class: "form-control", placeholder: 'search', data: { action: 'keyup->auto-submit#submit' } %>
        </div>
      <% end %>

      <p>
        <%= link_to "New note", new_note_path, class: "btn btn-primary my-4" %>
      </p>
    </div>
  </section>



  <%= turbo_frame_tag "notes", target: "_top", class: "album py-5 bg-light" do %>
    <div class="container">
      <div class="row">
        <% @notes.each do |note| %>
          <%= render note %>
        <% end %>
      </div>
    </div>
  <% end %>
