<div class="container">

  <div class="my-4">
    <%= link_to "Notes", notes_path %>
  </div>

  <div class="my-4">
    <h1><%= @note.title %></h1>
  </div>

  <p> <%= @note.body %> </p>

  <div class="d-flex gap-2 my-4">
    <%= link_to "Edit", edit_note_path(@note), class: "btn btn-sm btn-outline-secondary" %>
    <%= button_to "delete", @note, :method => :delete, class: "btn btn-sm btn-outline-secondary"  %>
  </div>
  
</div>
